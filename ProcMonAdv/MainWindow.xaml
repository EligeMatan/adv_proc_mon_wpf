<Window x:Class="ProcMonAdv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProcMonAdv"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="149*" />
            <ColumnDefinition Width="251*" />
            <ColumnDefinition Width="200*" />
            <ColumnDefinition Width="200*" />
        </Grid.ColumnDefinitions>


        <Grid.RowDefinitions>
            <RowDefinition Height="37*" />
            <RowDefinition Height="29*" />
            <RowDefinition Height="368*" />
        </Grid.RowDefinitions >

        <Button x:Name="BtnStart" Content="Старт" HorizontalAlignment="Center" VerticalAlignment="Center" Width="118" Height="20" Click="BtnStart_Click" />
        <Button Content="Button" HorizontalAlignment="Center" VerticalAlignment="Center" Width="118" Height="20" Grid.Column="1"/>
        <TreeView Grid.Row="2" Grid.Column="0" Margin="0,2,0,0">
            <TreeViewItem Header="TreeViewItem"/>
            <TreeViewItem Header="TreeViewItem"/>
            <TreeViewItem Header="TreeViewItem"/>
        </TreeView>


    </Grid>
</Window>
